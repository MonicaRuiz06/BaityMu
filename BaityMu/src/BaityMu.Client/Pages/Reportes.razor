@page "/reportes"
@implements IDisposable
@inject BaityMuApi Api
@inject EstadoApp Estado

<PageTitle>Reportes · BaityMu</PageTitle>

<div class="encabezado">
    <div>
        <span class="rol">BaityGerente</span>
        <h1>Reportes</h1>
        <p>Elige el período y el reporte. Las fechas empiezan en el mes del día de trabajo.</p>
    </div>
</div>

<section class="panel">
    @if (_vista == Vista.Balance)
    {
        <p class="atenuada" style="margin:0">
            El balance cuenta todo desde el inicio. Lo <strong>disponible</strong> se calcula al
            @Formato.Fecha(Estado.Dia) (el día de trabajo): un lote vencido ese día ya no cuenta.
        </p>
    }
    else
    {
    <div class="campos-fila">
        <label class="campo">
            <span>Desde</span>
            <input type="date" @bind="_desde" @bind:after="CargarAsync" />
        </label>
        <label class="campo">
            <span>Hasta</span>
            <input type="date" @bind="_hasta" @bind:after="CargarAsync" />
        </label>
        @if (_vista is Vista.Ventas or Vista.Danado)
        {
            <div class="campo">
                <span>Producto</span>
                <div class="pestanas" role="tablist">
                    <button type="button" class="@(_tipo is null ? "activa" : "")" @onclick="() => FiltrarAsync(null)">Todos</button>
                    <button type="button" class="@(_tipo == TipoProducto.Queso ? "activa" : "")" @onclick="() => FiltrarAsync(TipoProducto.Queso)">🧀 Queso</button>
                    <button type="button" class="@(_tipo == TipoProducto.Yogurt ? "activa" : "")" @onclick="() => FiltrarAsync(TipoProducto.Yogurt)">🥣 Yogurt</button>
                </div>
            </div>
        }
    </div>
    }
</section>

<section class="seccion">
    <div class="barra-herramientas">
        <div class="pestanas" role="tablist" aria-label="Reporte">
            <button type="button" class="@(_vista == Vista.Ventas ? "activa" : "")" @onclick="() => CambiarVistaAsync(Vista.Ventas)">🛒 Ventas</button>
            <button type="button" class="@(_vista == Vista.Leche ? "activa" : "")" @onclick="() => CambiarVistaAsync(Vista.Leche)">🥛 Leche por día</button>
            <button type="button" class="@(_vista == Vista.Producto ? "activa" : "")" @onclick="() => CambiarVistaAsync(Vista.Producto)">🧀 Producto por día</button>
            <button type="button" class="@(_vista == Vista.Balance ? "activa" : "")" @onclick="() => CambiarVistaAsync(Vista.Balance)">⚖️ Balance</button>
            <button type="button" class="@(_vista == Vista.Danado ? "activa" : "")" @onclick="() => CambiarVistaAsync(Vista.Danado)">🗑️ Dañado</button>
            <button type="button" class="@(_vista == Vista.Vacas ? "activa" : "")" @onclick="() => CambiarVistaAsync(Vista.Vacas)">🐄 Vacas</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <ErrorCarga Error="_error" Reintentar="CargarAsync" />
    }
    else if (_cargando)
    {
        <Cargando />
    }
    else if (_vista == Vista.Ventas && _ventas is not null)
    {
        <div class="grilla grilla-3">
            <Metrica Etiqueta="Total vendido" Valor="@Formato.Pesos(_ventas.TotalGeneral)"
                     Nota="@($"{TextoVentas(_ventas.Ventas.Count)} en el período")" Destacada="true" />
            @foreach (var tipo in Productos)
            {
                var t = _ventas.TotalesPorProducto.FirstOrDefault(x => x.TipoProducto == tipo);
                <Metrica Etiqueta="@($"{(tipo == TipoProducto.Queso ? "🧀" : "🥣")} {tipo}")"
                         Valor="@Formato.Pesos(t?.Total ?? 0)"
                         Nota="@($"{Formato.ConUnidad(t?.Cantidad ?? 0, tipo)} · {TextoVentas(t?.NumeroVentas ?? 0)}")" />
            }
        </div>

        @if (_ventas.Ventas.Count == 0)
        {
            <SinDatos Icono="🧾" Texto="@($"No hubo ventas entre el {Formato.Fecha(_desde)} y el {Formato.Fecha(_hasta)}.")" />
        }
        else
        {
            <div class="tabla-envoltura" style="margin-top:16px">
                <table>
                    <thead>
                        <tr><th>Venta</th><th>Fecha</th><th>Producto</th><th class="num">Cantidad</th><th class="num">Precio</th><th class="num">Total</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _ventas.Ventas)
                        {
                            <tr>
                                <td>#@v.Id</td>
                                <td>@Formato.Fecha(v.Fecha)</td>
                                <td><span class="insignia insignia-@v.TipoProducto.ToString().ToLowerInvariant()">@v.TipoProducto</span></td>
                                <td class="num">@Formato.ConUnidad(v.Cantidad, v.TipoProducto)</td>
                                <td class="num">@Formato.Pesos(v.PrecioUnitario)</td>
                                <td class="num">@Formato.Pesos(v.Total)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="5">Total general</th><th class="num">@Formato.Pesos(_ventas.TotalGeneral)</th></tr>
                    </tfoot>
                </table>
            </div>
        }
    }
    else if (_vista == Vista.Leche && _leche is not null)
    {
        <div class="grilla grilla-3">
            <Metrica Etiqueta="Leche producida" Valor="@Formato.Litros(_leche.TotalProducido)"
                     Nota="@($"{_leche.Dias.Count} días con ordeño")" Destacada="true" />
            <Metrica Etiqueta="Transformada" Valor="@Formato.Litros(_leche.TotalTransformado)" Nota="En queso y yogurt" />
            <Metrica Etiqueta="No aprovechada" Valor="@Formato.Litros(_leche.TotalNoAprovechado)" Nota="Leche que no se transformó" />
        </div>

        @if (_leche.Dias.Count == 0)
        {
            <SinDatos Icono="🥛" Texto="@($"No hubo ordeño entre el {Formato.Fecha(_desde)} y el {Formato.Fecha(_hasta)}.")" />
        }
        else
        {
            <div class="tabla-envoltura" style="margin-top:16px">
                <table>
                    <thead>
                        <tr><th>Día</th><th class="num">Producida</th><th class="num">Transformada</th><th class="num">No aprovechada</th><th>Uso de la leche</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _leche.Dias)
                        {
                            <tr>
                                <td>@Formato.Fecha(d.Fecha)</td>
                                <td class="num">@Formato.Litros(d.LitrosProducidos)</td>
                                <td class="num">@Formato.Litros(d.LitrosTransformados)</td>
                                <td class="num" style="@(d.LitrosNoAprovechados > 0 ? "color:var(--arcilla);font-weight:600" : "")">@Formato.Litros(d.LitrosNoAprovechados)</td>
                                <td style="min-width:140px">
                                    <div class="leche-barra" role="img" aria-label="@($"{Porcentaje(d.LitrosTransformados, d.LitrosProducidos)} transformada")">
                                        <span class="leche-usada" style="width:@Porcentaje(d.LitrosTransformados, d.LitrosProducidos)"></span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total</th>
                            <th class="num">@Formato.Litros(_leche.TotalProducido)</th>
                            <th class="num">@Formato.Litros(_leche.TotalTransformado)</th>
                            <th class="num">@Formato.Litros(_leche.TotalNoAprovechado)</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    }
    else if (_vista == Vista.Producto && _producto is not null)
    {
        <div class="grilla grilla-3">
            @foreach (var tipo in new[] { TipoProducto.Queso, TipoProducto.Yogurt })
            {
                var t = _producto.TotalesPorProducto.FirstOrDefault(x => x.TipoProducto == tipo);
                <Metrica Etiqueta="@($"{(tipo == TipoProducto.Queso ? "🧀" : "🥣")} {tipo} elaborado")"
                         Valor="@Formato.ConUnidad(t?.Cantidad ?? 0, tipo)"
                         Nota="@($"{Formato.Litros(t?.LitrosUsados ?? 0)} de leche · {TextoLotes(t?.NumeroLotes ?? 0)}")"
                         Destacada="@(tipo == TipoProducto.Queso)" />
            }
            <Metrica Etiqueta="Leche transformada" Valor="@Formato.Litros(_producto.TotalesPorProducto.Sum(t => t.LitrosUsados))"
                     Nota="@($"{_producto.Dias.Select(d => d.Fecha).Distinct().Count()} días con elaboración")" />
        </div>

        @if (_producto.Dias.Count == 0)
        {
            <SinDatos Icono="🧀" Texto="@($"No se elaboró producto entre el {Formato.Fecha(_desde)} y el {Formato.Fecha(_hasta)}.")" />
        }
        else
        {
            <div class="tabla-envoltura" style="margin-top:16px">
                <table>
                    <thead>
                        <tr><th>Día</th><th>Producto</th><th class="num">Elaborado</th><th class="num">Leche usada</th><th class="num">Lotes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _producto.Dias)
                        {
                            <tr>
                                <td>@(d.Fecha is { } f ? Formato.Fecha(f) : "")</td>
                                <td><span class="insignia insignia-@d.TipoProducto.ToString().ToLowerInvariant()">@d.TipoProducto</span></td>
                                <td class="num"><strong>@Formato.Cantidad(d.Cantidad) @d.Unidad</strong></td>
                                <td class="num">@Formato.Litros(d.LitrosUsados)</td>
                                <td class="num">@d.NumeroLotes</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @foreach (var t in _producto.TotalesPorProducto)
                        {
                            <tr>
                                <th colspan="2">Total @t.TipoProducto</th>
                                <th class="num">@Formato.Cantidad(t.Cantidad) @t.Unidad</th>
                                <th class="num">@Formato.Litros(t.LitrosUsados)</th>
                                <th class="num">@t.NumeroLotes</th>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        }
    }
    else if (_vista == Vista.Balance && _balance is not null)
    {
        <div class="grilla grilla-2">
            @foreach (var b in _balance)
            {
                <section class="panel">
                    <div class="barra-herramientas" style="margin-bottom:8px">
                        <h3>@(b.TipoProducto == TipoProducto.Queso ? "🧀" : "🥣") @b.TipoProducto</h3>
                        <span class="atenuada">Producido: <strong>@Formato.Cantidad(b.Producido) @b.Unidad</strong></span>
                    </div>
                    <div class="leche-barra" style="height:18px" role="img"
                         aria-label="@($"Vendido {Formato.Cantidad(b.Vendido)}, disponible {Formato.Cantidad(b.Disponible)}, dañado {Formato.Cantidad(b.Dañado)} {b.Unidad}")">
                        <span style="width:@Porcentaje(b.Vendido, b.Producido);background:var(--paja)"></span>
                        <span style="width:@Porcentaje(b.Disponible, b.Producido);background:var(--potrero)"></span>
                        <span style="width:@Porcentaje(b.VencidoSinProcesar, b.Producido);background:var(--paja-oscura)"></span>
                        <span style="width:@Porcentaje(b.Dañado, b.Producido);background:var(--arcilla)"></span>
                    </div>
                    <div class="leche-leyenda">
                        <span><i style="background:var(--paja)"></i>Vendido: <strong>@Formato.Cantidad(b.Vendido) @b.Unidad</strong></span>
                        <span><i style="background:var(--potrero)"></i>Disponible: <strong>@Formato.Cantidad(b.Disponible) @b.Unidad</strong></span>
                        @if (b.VencidoSinProcesar > 0)
                        {
                            <span><i style="background:var(--paja-oscura)"></i>Vencido sin procesar: <strong>@Formato.Cantidad(b.VencidoSinProcesar) @b.Unidad</strong></span>
                        }
                        <span><i style="background:var(--arcilla)"></i>Dañado: <strong>@Formato.Cantidad(b.Dañado) @b.Unidad</strong></span>
                    </div>
                </section>
            }
        </div>

        <div class="tabla-envoltura" style="margin-top:16px">
            <table>
                <thead>
                    <tr><th>Producto</th><th class="num">Producido</th><th class="num">Vendido</th><th class="num">Disponible</th>
                        @if (HayVencidoSinProcesar)
                        {
                            <th class="num">Vencido sin procesar</th>
                        }
                        <th class="num">Dañado</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in _balance)
                    {
                        <tr>
                            <td><span class="insignia insignia-@b.TipoProducto.ToString().ToLowerInvariant()">@b.TipoProducto</span> (@b.Unidad)</td>
                            <td class="num">@Formato.Cantidad(b.Producido)</td>
                            <td class="num">@Formato.Cantidad(b.Vendido)</td>
                            <td class="num">@Formato.Cantidad(b.Disponible)</td>
                            @if (HayVencidoSinProcesar)
                            {
                                <td class="num">@Formato.Cantidad(b.VencidoSinProcesar)</td>
                            }
                            <td class="num" style="@(b.Dañado > 0 ? "color:var(--arcilla);font-weight:600" : "")">@Formato.Cantidad(b.Dañado)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (HayVencidoSinProcesar)
        {
            <div class="panel panel-nota" style="margin-top:16px">
                ⚠ Hay producto vencido que todavía no se ha marcado como dañado.
                <a href="inventario">Procésalo en Inventario</a> para que pase a la columna Dañado.
            </div>
        }
    }
    else if (_vista == Vista.Danado && _danado is not null)
    {
        <p class="atenuada" style="margin:0 0 12px">
            Las fechas filtran por <strong>fecha de vencimiento</strong>. Solo aparece lo que ya se procesó en
            <a href="inventario">Inventario</a>: ahí es cuando lo vencido pasa a dañado.
        </p>
        <div class="grilla grilla-3">
            @foreach (var tipo in Productos)
            {
                var t = _danado.TotalesPorProducto.FirstOrDefault(x => x.TipoProducto == tipo);
                <Metrica Etiqueta="@($"{(tipo == TipoProducto.Queso ? "🧀" : "🥣")} {tipo} dañado")"
                         Valor="@Formato.ConUnidad(t?.Cantidad ?? 0, tipo)"
                         Nota="@TextoLotes(t?.NumeroLotes ?? 0)"
                         Destacada="@((t?.Cantidad ?? 0) > 0)" />
            }
        </div>

        @if (_danado.Lotes.Count == 0)
        {
            <SinDatos Icono="✨" Texto="@($"No se dañó producto con vencimiento entre el {Formato.Fecha(_desde)} y el {Formato.Fecha(_hasta)}.")" />
        }
        else
        {
            <div class="tabla-envoltura" style="margin-top:16px">
                <table>
                    <thead>
                        <tr><th>Lote</th><th>Producto</th><th>Producido</th><th>Venció</th><th class="num">Dañado</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _danado.Lotes)
                        {
                            <tr>
                                <td>#@l.LoteId</td>
                                <td><span class="insignia insignia-@l.TipoProducto.ToString().ToLowerInvariant()">@l.TipoProducto</span></td>
                                <td>@Formato.Fecha(l.FechaProduccion)</td>
                                <td>@Formato.Fecha(l.FechaVencimiento)</td>
                                <td class="num" style="color:var(--arcilla);font-weight:600">@Formato.Cantidad(l.CantidadDañada) @l.Unidad</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @foreach (var t in _danado.TotalesPorProducto)
                        {
                            <tr><th colspan="4">Total @t.TipoProducto</th><th class="num">@Formato.Cantidad(t.Cantidad) @t.Unidad</th></tr>
                        }
                    </tfoot>
                </table>
            </div>
        }
    }
    else if (_vista == Vista.Vacas && _vacas is not null)
    {
        @if (_vacas.VacasEvaluadas == 0)
        {
            <SinDatos Icono="🐄" Texto="@($"No hubo ordeño entre el {Formato.Fecha(_desde)} y el {Formato.Fecha(_hasta)}: no hay vacas que evaluar.")" />
        }
        else
        {
            <div class="grilla grilla-4">
                <Metrica Etiqueta="Promedio diario del hato" Valor="@Formato.Litros(_vacas.PromedioDiarioHato)"
                         Nota="@($"{Formato.Litros(_vacas.LitrosTotales)} en {_vacas.DiasConProduccion} días")" Destacada="true" />
                <Metrica Etiqueta="Promedio por vaca" Valor="@Formato.Litros(_vacas.PromedioPorVaca)"
                         Nota="@($"Por día · {_vacas.VacasEvaluadas} vacas evaluadas")" />
                <Metrica Etiqueta="🏆 La que más produce" Valor="@Formato.Litros(_vacas.VacaMayor!.PromedioDiario)"
                         Nota="@($"{_vacas.VacaMayor.Nombre} · por día")" />
                <Metrica Etiqueta="La que menos produce" Valor="@Formato.Litros(_vacas.VacaMenor!.PromedioDiario)"
                         Nota="@($"{_vacas.VacaMenor.Nombre} · por día")" />
            </div>

            @if (_vacas.PorDebajoDelPromedio.Count == 0)
            {
                <div class="panel panel-nota" style="margin-top:16px">
                    ✅ Ninguna vaca está por debajo del promedio de @Formato.Litros(_vacas.PromedioPorVaca) por día.
                </div>
            }
            else
            {
                <div class="panel panel-nota" style="margin-top:16px">
                    ⚠ @(_vacas.PorDebajoDelPromedio.Count == 1 ? "1 vaca está" : $"{_vacas.PorDebajoDelPromedio.Count} vacas están")
                    por debajo del promedio de @Formato.Litros(_vacas.PromedioPorVaca) por día:
                    @string.Join(", ", _vacas.PorDebajoDelPromedio.Select(v => $"{v.Nombre} (le faltan {Formato.Litros(v.Faltante)})")).
                </div>
            }

            <div class="tabla-envoltura" style="margin-top:16px">
                <table>
                    <thead>
                        <tr><th>Vaca</th><th>Raza</th><th class="num">Días</th><th class="num">Litros</th><th class="num">Promedio/día</th><th style="min-width:140px">Frente al promedio</th><th class="num">Le falta</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _vacas.Vacas)
                        {
                            var debajo = v.Faltante > 0;
                            <tr>
                                <td>
                                    <a href="@($"vacas/{v.VacaId}")">@v.Nombre</a>
                                    @if (!v.Activa)
                                    {
                                        <span class="atenuada" style="font-size:.78rem"> · retirada</span>
                                    }
                                </td>
                                <td>@v.Raza</td>
                                <td class="num">@v.DiasOrdenada</td>
                                <td class="num">@Formato.Litros(v.LitrosTotales)</td>
                                <td class="num"><strong>@Formato.Litros(v.PromedioDiario)</strong></td>
                                <td>
                                    <div class="leche-barra" role="img" aria-label="@($"{Formato.Litros(v.PromedioDiario)} de {Formato.Litros(MaximoVaca)}")">
                                        <span style="width:@Porcentaje(v.PromedioDiario, MaximoVaca);background:@(debajo ? "var(--arcilla)" : "var(--potrero)")"></span>
                                    </div>
                                </td>
                                <td class="num" style="@(debajo ? "color:var(--arcilla);font-weight:600" : "")">@(debajo ? Formato.Litros(v.Faltante) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    /// <summary>Los reportes que ya existen en la API. Cada HU agrega el suyo.</summary>
    private enum Vista { Ventas, Leche, Producto, Balance, Danado, Vacas }

    private Vista _vista = Vista.Ventas;
    private DateOnly _desde;
    private DateOnly _hasta;
    private TipoProducto? _tipo;
    private ReporteVentas? _ventas;
    private ReporteLecheDiaria? _leche;
    private ReporteProductoDiario? _producto;
    private List<ProductoTotal>? _balance;
    private ReporteProductoDanado? _danado;
    private ReporteVacas? _vacas;

    /// <summary>El mayor promedio: es el 100 % de las barras de la tabla de vacas.</summary>
    private decimal MaximoVaca => _vacas?.VacaMayor?.PromedioDiario ?? 0;

    private bool HayVencidoSinProcesar => _balance?.Any(b => b.VencidoSinProcesar > 0) == true;
    private ApiException? _error;
    private bool _cargando;

    private static string TextoVentas(int n) => n == 1 ? "1 venta" : $"{n} ventas";

    private static string TextoLotes(int n) => n == 1 ? "1 lote" : $"{n} lotes";

    private static string Porcentaje(decimal parte, decimal total) =>
        total == 0 ? "0%" : (parte / total * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    /// <summary>Con filtro de producto solo se muestra esa tarjeta.</summary>
    private IEnumerable<TipoProducto> Productos =>
        _tipo is { } t ? new[] { t } : new[] { TipoProducto.Queso, TipoProducto.Yogurt };

    protected override async Task OnInitializedAsync()
    {
        Estado.DiaCambiado += AlCambiarDia;
        UsarMesDelDia();
        await CargarAsync();
    }

    /// <summary>Por defecto: del 1 al último día del mes del día de trabajo.</summary>
    private void UsarMesDelDia()
    {
        _desde = new DateOnly(Estado.Dia.Year, Estado.Dia.Month, 1);
        _hasta = _desde.AddMonths(1).AddDays(-1);
    }

    private async void AlCambiarDia()
    {
        UsarMesDelDia();
        await CargarAsync();
        StateHasChanged();
    }

    public void Dispose() => Estado.DiaCambiado -= AlCambiarDia;

    private async Task CambiarVistaAsync(Vista vista)
    {
        _vista = vista;
        await CargarAsync();
    }

    private async Task FiltrarAsync(TipoProducto? tipo)
    {
        _tipo = tipo;
        await CargarAsync();
    }

    /// <summary>Pide a la API solo el reporte de la pestaña abierta.</summary>
    private async Task CargarAsync()
    {
        _error = null;
        _cargando = true;
        try
        {
            switch (_vista)
            {
                case Vista.Ventas:
                    _ventas = await Api.ReporteVentasAsync(_desde, _hasta, _tipo);
                    break;
                case Vista.Leche:
                    _leche = await Api.ReporteLecheDiariaAsync(_desde, _hasta);
                    break;
                case Vista.Producto:
                    _producto = await Api.ReporteProductoDiarioAsync(_desde, _hasta);
                    break;
                case Vista.Balance:
                    _balance = await Api.ReporteProductoTotalAsync(Estado.Dia);
                    break;
                case Vista.Danado:
                    _danado = await Api.ReporteProductoDanadoAsync(_desde, _hasta, _tipo);
                    break;
                case Vista.Vacas:
                    _vacas = await Api.ReporteVacasAsync(_desde, _hasta);
                    break;
            }
        }
        catch (ApiException e)
        {
            // Rango al revés: la API responde 400 y se muestra su mensaje.
            _error = e;
        }
        finally
        {
            _cargando = false;
        }
    }
}
