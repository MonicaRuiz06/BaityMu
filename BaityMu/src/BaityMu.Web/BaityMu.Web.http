# BaityMu — colección de pruebas manuales.
# En Visual Studio, con la API ejecutándose, haz clic en "Enviar solicitud" sobre cada petición.
# Cada historia de usuario irá agregando aquí sus peticiones; al final quedará el
# escenario de referencia completo del taller (días 1 a 17).

@BaityMu.Web_HostAddress = http://localhost:5251

### Bienvenida: confirma que la API está viva
GET {{BaityMu.Web_HostAddress}}/
Accept: application/json

### Manejador de errores (solo en desarrollo) — 400 Bad Request
GET {{BaityMu.Web_HostAddress}}/api/diagnostico/errores/400
Accept: application/json

### Manejador de errores — 404 Not Found
GET {{BaityMu.Web_HostAddress}}/api/diagnostico/errores/404
Accept: application/json

### Manejador de errores — 409 Conflict
GET {{BaityMu.Web_HostAddress}}/api/diagnostico/errores/409
Accept: application/json

### Manejador de errores — 500 Internal Server Error (no muestra detalles internos)
GET {{BaityMu.Web_HostAddress}}/api/diagnostico/errores/500
Accept: application/json

### HU-01 Registrar una vaca con nombre → 201
POST {{BaityMu.Web_HostAddress}}/api/vacas
Content-Type: application/json

{
  "raza": "Jersey",
  "nombre": "Lola",
  "fechaIngreso": "2026-12-01"
}

### HU-01 Registrar una vaca sin nombre → 201 (BaityCow N)
POST {{BaityMu.Web_HostAddress}}/api/vacas
Content-Type: application/json

{
  "raza": "Holstein"
}

### HU-01 Raza vacía → 400
POST {{BaityMu.Web_HostAddress}}/api/vacas
Content-Type: application/json

{
  "raza": ""
}

### HU-01 Nombre repetido → 409 (BaityCow ya existe)
POST {{BaityMu.Web_HostAddress}}/api/vacas
Content-Type: application/json

{
  "raza": "Holstein",
  "nombre": "BaityCow"
}

### HU-02 Listar las vacas activas con sus litros → 200
GET {{BaityMu.Web_HostAddress}}/api/vacas
Accept: application/json

### HU-02 Listar incluyendo las retiradas → 200
GET {{BaityMu.Web_HostAddress}}/api/vacas?incluirRetiradas=true
Accept: application/json

### HU-03 Consultar una vaca con su historial → 200
GET {{BaityMu.Web_HostAddress}}/api/vacas/1
Accept: application/json

### HU-03 Vaca inexistente → 404
GET {{BaityMu.Web_HostAddress}}/api/vacas/999
Accept: application/json

### HU-04 Retirar una vaca → 204 (después no sale en GET /api/vacas)
DELETE {{BaityMu.Web_HostAddress}}/api/vacas/10

### HU-04 Retirarla otra vez → 409
DELETE {{BaityMu.Web_HostAddress}}/api/vacas/10

### HU-04 Vaca inexistente → 404
DELETE {{BaityMu.Web_HostAddress}}/api/vacas/999

### HU-05 Consultar la configuración de la granja → 200 (n × l = 150 L)
GET {{BaityMu.Web_HostAddress}}/api/granja
Accept: application/json

### HU-06 Cambiar el precio del yogurt → 200
PUT {{BaityMu.Web_HostAddress}}/api/granja
Content-Type: application/json

{
  "productos": [
    { "tipoProducto": "Yogurt", "litrosPorUnidad": 1, "vidaUtilDias": 15, "precioUnitario": 6500 }
  ]
}

### HU-06 Valor inválido (vida útil 0) → 400 y no cambia nada
PUT {{BaityMu.Web_HostAddress}}/api/granja
Content-Type: application/json

{
  "litrosPorVaca": 16,
  "productos": [
    { "tipoProducto": "Queso", "litrosPorUnidad": 10, "vidaUtilDias": 0, "precioUnitario": 28000 }
  ]
}

### HU-06 Volver a los valores del taller → 200
PUT {{BaityMu.Web_HostAddress}}/api/granja
Content-Type: application/json

{
  "litrosPorVaca": 15,
  "productos": [
    { "tipoProducto": "Queso", "unidad": "kg", "litrosPorUnidad": 10, "vidaUtilDias": 30, "precioUnitario": 28000 },
    { "tipoProducto": "Yogurt", "unidad": "L", "litrosPorUnidad": 1, "vidaUtilDias": 15, "precioUnitario": 6000 }
  ]
}

### HU-07 Escenario día 1: registrar la producción (n × l = 150 L) → 201
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-12-01"
}

### HU-07 Registrar otra vez el día 1 → 409 (RN-01)
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-12-01"
}

### HU-07 Escenario día 2 → 201
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-12-02"
}

### HU-07 Litros específicos para algunas vacas → 201
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-11-30",
  "vacas": [
    { "vacaId": 1, "litros": 14.5 },
    { "vacaId": 2, "litros": 16 }
  ]
}

### HU-07 Litros negativos → 400
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-11-29",
  "vacas": [ { "vacaId": 1, "litros": -3 } ]
}

### HU-07 Vaca inexistente → 404
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-11-29",
  "vacas": [ { "vacaId": 999, "litros": 15 } ]
}

### HU-08 Consultar la producción del día 1 → 200
GET {{BaityMu.Web_HostAddress}}/api/produccion/2026-12-01
Accept: application/json

### HU-08 Día sin producción → 404
GET {{BaityMu.Web_HostAddress}}/api/produccion/2020-01-01
Accept: application/json

###
