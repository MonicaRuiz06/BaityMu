# BaityMu — colección de pruebas manuales.
# En Visual Studio, con la API ejecutándose, haz clic en "Enviar solicitud" sobre cada petición.
# Cada historia de usuario irá agregando aquí sus peticiones; al final quedará el
# escenario de referencia completo del taller (días 1 a 17).

@BaityMu.Web_HostAddress = http://localhost:5251

### Bienvenida: confirma que la API está viva
GET {{BaityMu.Web_HostAddress}}/
Accept: application/json

### Manejador de errores (solo en desarrollo) — 400 Bad Request
GET {{BaityMu.Web_HostAddress}}/api/diagnostico/errores/400
Accept: application/json

### Manejador de errores — 404 Not Found
GET {{BaityMu.Web_HostAddress}}/api/diagnostico/errores/404
Accept: application/json

### Manejador de errores — 409 Conflict
GET {{BaityMu.Web_HostAddress}}/api/diagnostico/errores/409
Accept: application/json

### Manejador de errores — 500 Internal Server Error (no muestra detalles internos)
GET {{BaityMu.Web_HostAddress}}/api/diagnostico/errores/500
Accept: application/json

### HU-01 Registrar una vaca con nombre → 201
POST {{BaityMu.Web_HostAddress}}/api/vacas
Content-Type: application/json

{
  "raza": "Jersey",
  "nombre": "Lola",
  "fechaIngreso": "2026-12-01"
}

### HU-01 Registrar una vaca sin nombre → 201 (BaityCow N)
POST {{BaityMu.Web_HostAddress}}/api/vacas
Content-Type: application/json

{
  "raza": "Holstein"
}

### HU-01 Raza vacía → 400
POST {{BaityMu.Web_HostAddress}}/api/vacas
Content-Type: application/json

{
  "raza": ""
}

### HU-01 Nombre repetido → 409 (BaityCow ya existe)
POST {{BaityMu.Web_HostAddress}}/api/vacas
Content-Type: application/json

{
  "raza": "Holstein",
  "nombre": "BaityCow"
}

### HU-02 Listar las vacas activas con sus litros → 200
GET {{BaityMu.Web_HostAddress}}/api/vacas
Accept: application/json

### HU-02 Listar incluyendo las retiradas → 200
GET {{BaityMu.Web_HostAddress}}/api/vacas?incluirRetiradas=true
Accept: application/json

### HU-03 Consultar una vaca con su historial → 200
GET {{BaityMu.Web_HostAddress}}/api/vacas/1
Accept: application/json

### HU-03 Vaca inexistente → 404
GET {{BaityMu.Web_HostAddress}}/api/vacas/999
Accept: application/json

### HU-04 Retirar una vaca → 204 (después no sale en GET /api/vacas)
DELETE {{BaityMu.Web_HostAddress}}/api/vacas/10

### HU-04 Retirarla otra vez → 409
DELETE {{BaityMu.Web_HostAddress}}/api/vacas/10

### HU-04 Vaca inexistente → 404
DELETE {{BaityMu.Web_HostAddress}}/api/vacas/999

### HU-05 Consultar la configuración de la granja → 200 (n × l = 150 L)
GET {{BaityMu.Web_HostAddress}}/api/granja
Accept: application/json

### HU-06 Cambiar el precio del yogurt → 200
PUT {{BaityMu.Web_HostAddress}}/api/granja
Content-Type: application/json

{
  "productos": [
    { "tipoProducto": "Yogurt", "litrosPorUnidad": 1, "vidaUtilDias": 15, "precioUnitario": 6500 }
  ]
}

### HU-06 Valor inválido (vida útil 0) → 400 y no cambia nada
PUT {{BaityMu.Web_HostAddress}}/api/granja
Content-Type: application/json

{
  "litrosPorVaca": 16,
  "productos": [
    { "tipoProducto": "Queso", "litrosPorUnidad": 10, "vidaUtilDias": 0, "precioUnitario": 28000 }
  ]
}

### HU-06 Volver a los valores del taller → 200
PUT {{BaityMu.Web_HostAddress}}/api/granja
Content-Type: application/json

{
  "litrosPorVaca": 15,
  "productos": [
    { "tipoProducto": "Queso", "unidad": "kg", "litrosPorUnidad": 10, "vidaUtilDias": 30, "precioUnitario": 28000 },
    { "tipoProducto": "Yogurt", "unidad": "L", "litrosPorUnidad": 1, "vidaUtilDias": 15, "precioUnitario": 6000 }
  ]
}

### HU-07 Escenario día 1: registrar la producción (n × l = 150 L) → 201
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-12-01"
}

### HU-07 Registrar otra vez el día 1 → 409 (RN-01)
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-12-01"
}

### HU-07 Escenario día 2 → 201
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-12-02"
}

### HU-07 Litros específicos para algunas vacas → 201
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-11-30",
  "vacas": [
    { "vacaId": 1, "litros": 14.5 },
    { "vacaId": 2, "litros": 16 }
  ]
}

### HU-07 Litros negativos → 400
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-11-29",
  "vacas": [ { "vacaId": 1, "litros": -3 } ]
}

### HU-07 Vaca inexistente → 404
POST {{BaityMu.Web_HostAddress}}/api/produccion
Content-Type: application/json

{
  "fecha": "2026-11-29",
  "vacas": [ { "vacaId": 999, "litros": 15 } ]
}

### HU-08 Consultar la producción del día 1 → 200
GET {{BaityMu.Web_HostAddress}}/api/produccion/2026-12-01
Accept: application/json

### HU-08 Día sin producción → 404
GET {{BaityMu.Web_HostAddress}}/api/produccion/2020-01-01
Accept: application/json

### HU-09 Escenario día 1: 100 L en queso → 201 (Q1 = 10 kg)
POST {{BaityMu.Web_HostAddress}}/api/transformaciones
Content-Type: application/json

{
  "fecha": "2026-12-01",
  "tipoProducto": "Queso",
  "litros": 100
}

### HU-09 Escenario día 1: 50 L en yogurt → 201 (Y1 = 50 L, vence 2026-12-16)
POST {{BaityMu.Web_HostAddress}}/api/transformaciones
Content-Type: application/json

{
  "fecha": "2026-12-01",
  "tipoProducto": "Yogurt",
  "litros": 50
}

### HU-09 Ya no queda leche del día 1 → 409 (RN-02)
POST {{BaityMu.Web_HostAddress}}/api/transformaciones
Content-Type: application/json

{
  "fecha": "2026-12-01",
  "tipoProducto": "Queso",
  "litros": 1
}

### HU-09 Escenario día 2: 150 L en queso → 201 (Q2 = 15 kg)
POST {{BaityMu.Web_HostAddress}}/api/transformaciones
Content-Type: application/json

{
  "fecha": "2026-12-02",
  "tipoProducto": "Queso",
  "litros": 150
}

### HU-09 Día sin producción → 409
POST {{BaityMu.Web_HostAddress}}/api/transformaciones
Content-Type: application/json

{
  "fecha": "2020-01-01",
  "tipoProducto": "Queso",
  "litros": 10
}

### HU-09 Litros en cero → 400
POST {{BaityMu.Web_HostAddress}}/api/transformaciones
Content-Type: application/json

{
  "fecha": "2026-12-01",
  "tipoProducto": "Yogurt",
  "litros": 0
}

### HU-10 Inventario completo, visto el día 3 del escenario → 200
GET {{BaityMu.Web_HostAddress}}/api/inventario?fecha=2026-12-03
Accept: application/json

### HU-10 Solo yogurt, visto el día 17 → Y1 aparece Vencido
GET {{BaityMu.Web_HostAddress}}/api/inventario?tipoProducto=Yogurt&fecha=2026-12-17
Accept: application/json

### HU-10 Un lote por Id → 200
GET {{BaityMu.Web_HostAddress}}/api/inventario/lotes/1
Accept: application/json

### HU-10 Lote inexistente → 404
GET {{BaityMu.Web_HostAddress}}/api/inventario/lotes/999
Accept: application/json

### HU-10 Resumen por producto, el día 17 → yogurt vencido sin procesar
GET {{BaityMu.Web_HostAddress}}/api/inventario/resumen?fecha=2026-12-17
Accept: application/json

### HU-11 Procesar vencimientos el día 16 → 200, nada se daña (Y1 vence ese día)
POST {{BaityMu.Web_HostAddress}}/api/inventario/procesar-vencimientos?fecha=2026-12-16

### HU-11 Escenario día 17: procesar vencimientos → 200, lo que queda de Y1 pasa a dañado
POST {{BaityMu.Web_HostAddress}}/api/inventario/procesar-vencimientos?fecha=2026-12-17

### HU-11 Procesar otra vez el día 17 → 200, no se duplica nada
POST {{BaityMu.Web_HostAddress}}/api/inventario/procesar-vencimientos?fecha=2026-12-17

### HU-13 Escenario día 3: 12 kg de queso → 201 (10 kg de Q1 + 2 kg de Q2)
POST {{BaityMu.Web_HostAddress}}/api/ventas
Content-Type: application/json

{
  "fecha": "2026-12-03",
  "tipoProducto": "Queso",
  "cantidad": 12
}

### HU-13 Escenario día 3: 20 L de yogurt → 201 (salen de Y1; quedan 30 L)
POST {{BaityMu.Web_HostAddress}}/api/ventas
Content-Type: application/json

{
  "fecha": "2026-12-03",
  "tipoProducto": "Yogurt",
  "cantidad": 20
}

### HU-13 Escenario día 17: 5 L de yogurt → 409 (no hay yogurt sin vencer)
POST {{BaityMu.Web_HostAddress}}/api/ventas
Content-Type: application/json

{
  "fecha": "2026-12-17",
  "tipoProducto": "Yogurt",
  "cantidad": 5
}

### HU-13 Cantidad en cero → 400
POST {{BaityMu.Web_HostAddress}}/api/ventas
Content-Type: application/json

{
  "fecha": "2026-12-03",
  "tipoProducto": "Queso",
  "cantidad": 0
}

### HU-14 Consultar la venta 1 con sus lotes → 200
GET {{BaityMu.Web_HostAddress}}/api/ventas/1
Accept: application/json

### HU-14 Venta inexistente → 404
GET {{BaityMu.Web_HostAddress}}/api/ventas/999
Accept: application/json

### HU-14 Ventas de queso del 1 al 31 de diciembre → 200
GET {{BaityMu.Web_HostAddress}}/api/ventas?desde=2026-12-01&hasta=2026-12-31&tipo=Queso
Accept: application/json

### HU-15 Reporte de ventas de diciembre → 200 (escenario día 3: total $456.000)
GET {{BaityMu.Web_HostAddress}}/api/reportes/ventas?desde=2026-12-01&hasta=2026-12-31
Accept: application/json

### HU-15 Reporte de ventas solo de yogurt → 200
GET {{BaityMu.Web_HostAddress}}/api/reportes/ventas?tipo=Yogurt
Accept: application/json

### HU-15 Rango al revés → 400
GET {{BaityMu.Web_HostAddress}}/api/reportes/ventas?desde=2026-12-31&hasta=2026-12-01
Accept: application/json

### HU-17 Producto por día de diciembre → 200 (escenario: día 1 = 10 kg queso + 50 L yogurt; día 2 = 15 kg queso)
GET {{BaityMu.Web_HostAddress}}/api/reportes/producto-diario?desde=2026-12-01&hasta=2026-12-31
Accept: application/json

### HU-16 Leche por día de diciembre → 200 (escenario: 150 L el día 1 y el día 2, 0 L sin aprovechar)
GET {{BaityMu.Web_HostAddress}}/api/reportes/leche-diaria?desde=2026-12-01&hasta=2026-12-31
Accept: application/json

